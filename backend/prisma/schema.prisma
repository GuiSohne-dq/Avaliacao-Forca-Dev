
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Palavra {
  id        Int       @id @default(autoincrement())
  palavra   String    @unique
  categoria String
  partidas  Partida[]

  @@map("palavras")
}

model Partida {
  id             Int       @id @default(autoincrement())
  jogador        String
  palavraId      Int
  palavra        Palavra   @relation(fields: [palavraId], references: [id])
  letrasTentadas String    @default("")
  erros          Int       @default(0)
  status         String    @default("em_andamento")
  pontos         Int       @default(0)
  criadaEm       DateTime  @default(now())
  finalizadaEm   DateTime?

  @@map("partidas")
}
